import /init.recovery.${ro.hardware}.rc

on early-init
    # Set the security context of /postinstall if present.
    restorecon /postinstall

    # Copy prebuilt ld.config.txt into linkerconfig directory
    copy /system/etc/ld.config.txt /linkerconfig/ld.config.txt
    chmod 444 /linkerconfig/ld.config.txt

    # Label the first-stage loop node before ueventd coldboot.
    restorecon /dev/loop-control
    start ueventd

    setprop sys.usb.configfs 0

on init
    export ANDROID_ROOT /system
    export ANDROID_DATA /data
    export EXTERNAL_STORAGE /sdcard

    symlink /proc/self/fd/0 /dev/stdin
    symlink /proc/self/fd/1 /dev/stdout
    symlink /proc/self/fd/2 /dev/stderr

    symlink /system/bin /bin
    symlink /system/etc /etc

    mkdir /sdcard
    mkdir /system
    mkdir /data
    mkdir /cache
    mkdir /sideload
    mkdir /mnt/system
    mount tmpfs tmpfs /tmp

    chown root shell /tmp
    chmod 0775 /tmp

    write /proc/sys/kernel/panic_on_oops 1
    write /proc/sys/vm/max_map_count 1000000

    # Mount binderfs
    mkdir /dev/binderfs
    mount binder binder /dev/binderfs stats=global
    chmod 0755 /dev/binderfs

    symlink /dev/binderfs/binder /dev/binder
    chmod 0666 /dev/binderfs/binder
    symlink /dev/binderfs/hwbinder /dev/hwbinder
    chmod 0666 /dev/binderfs/hwbinder

    # Start essential services
    start servicemanager

on post-fs
    # SONY: Start the TrimArea Daemon
    wait /dev/block/bootdevice/by-name/TA
    exec u:r:tad:s0 -- /system/bin/chmod 660 /dev/block/bootdevice/by-name/TA
    exec u:r:tad:s0 -- /system/bin/chown oem_2997:oem_2997 /dev/block/bootdevice/by-name/TA
    class_start trimarea
    exec u:r:tad:s0 system -- /system/bin/wait4tad

on boot
    # XQ-FS72: use the stock Android governor instead of kernel-default performance.
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor walt
    write /sys/devices/system/cpu/cpufreq/policy6/scaling_governor walt
    ifup lo
    hostname localhost
    domainname localdomain

    class_start default
    class_start hal

on firmware_mounts_complete
   rm /dev/.booting

# Mount filesystems and start core system services.
on late-init
    trigger early-fs
    trigger fs
    trigger post-fs
    trigger post-fs-data

    # Remove a file to wake up anything waiting for firmware
    trigger firmware_mounts_complete

    trigger early-boot
    trigger boot

service ueventd /system/bin/ueventd
    critical
    seclabel u:r:ueventd:s0
    user root

service charger /system/bin/charger
    critical
    seclabel u:r:charger:s0
    user root

service recovery /system/bin/sh /system/bin/xperia-recovery-start.sh
    socket recovery stream 422 system system
    seclabel u:r:recovery:s0
    user root

service adbd /system/bin/adbd --root_seclabel=u:r:su:s0 --device_banner=recovery
    disabled
    socket adbd stream 660 system system
    seclabel u:r:adbd:s0
    user root

service fastbootd /system/bin/fastbootd
    disabled
    group system
    seclabel u:r:fastbootd:s0
    user root

# Restart adbd so it can run as root
on property:service.adb.root=1
    restart adbd

on fs && property:sys.usb.configfs=1
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x${ro.recovery.usb.vid}
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/ffs.fastboot
    mkdir /config/usb_gadget/g1/configs/b.1 0777 shell shell
    # Set current limit to 900mA (b/277022505)
    write /config/usb_gadget/g1/configs/b.1/MaxPower 0x384
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell

on fs && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/f_ffs/aliases adb,fastboot
    write /sys/class/android_usb/android0/idVendor ${ro.recovery.usb.vid}
    write /sys/class/android_usb/android0/iManufacturer ${ro.product.manufacturer}
    write /sys/class/android_usb/android0/iProduct ${ro.product.model}
    write /sys/class/android_usb/android0/iSerial ${ro.serialno}

on fs
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    mkdir /dev/usb-ffs/fastboot 0770 system system
    mount functionfs fastboot /dev/usb-ffs/fastboot rmode=0770,fmode=0660,uid=1000,gid=1000

on property:sys.usb.config=adb
    start adbd

on property:sys.usb.config=fastboot
    start fastbootd

on property:sys.usb.config=none && property:sys.usb.configfs=0
    stop adbd
    stop fastbootd
    write /sys/class/android_usb/android0/enable 0
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=adb && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/idProduct ${ro.recovery.usb.adb.pid}
    write /sys/class/android_usb/android0/functions adb
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=sideload && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/idProduct ${ro.recovery.usb.adb.pid}
    write /sys/class/android_usb/android0/functions adb
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=fastboot && property:sys.usb.configfs=0
    write /sys/class/android_usb/android0/idProduct ${ro.recovery.usb.fastboot.pid}
    write /sys/class/android_usb/android0/functions fastboot
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state ${sys.usb.config}

# Configfs triggers
on property:sys.usb.config=none && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    stop adbd
    stop fastbootd
    setprop sys.usb.ffs.ready 0
    rm /config/usb_gadget/g1/configs/b.1/f1
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=sideload && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct 0x${ro.recovery.usb.adb.pid}
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=adb && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct 0x${ro.recovery.usb.adb.pid}
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "adb"
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=fastboot && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct 0x${ro.recovery.usb.fastboot.pid}
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "fastboot"
    symlink /config/usb_gadget/g1/functions/ffs.fastboot /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

service tad /system/bin/tad /dev/block/bootdevice/by-name/TA 0,16
    user oem_2997
    group oem_2997 root
    socket tad stream 0660 system oem_2993
    class trimarea
    seclabel u:r:tad:s0

on property:sys.xperia.fbe_probe=1
    loglevel 7
    copy /system/bin/xperia_recovery_service_trace /tmp/xperia_recovery_service_trace
    chmod 0755 /tmp/xperia_recovery_service_trace
    write /tmp/xperia-service.log "Sony service trace"
    chown root system /tmp/xperia-service.log
    chmod 0664 /tmp/xperia-service.log
    copy /xperia_fbe_ld.config.txt /linkerconfig/ld.config.txt
    wait /dev/block/by-name/modem_a 3
    mount vfat /dev/block/by-name/modem_a /vendor/firmware_mnt ro shortname=lower,uid=0,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0
    start xperia_log_sink
    wait /dev/socket/logdw 2
    mkdir /mnt/xperia-stock-system 0755 root root
    wait /dev/block/mapper/system_a 3
    mount ext4 /dev/block/mapper/system_a /mnt/xperia-stock-system ro nodev nosuid noload
    wait /dev/block/mapper/odm_a 3
    mount ext4 /dev/block/mapper/odm_a /odm ro nodev nosuid noexec noload
    mount none /mnt/xperia-stock-system/system/etc/vintf /system/etc/vintf bind
    setprop ro.boot.product.vendor.sku sun
    setprop servicemanager.ready false
    stop servicemanager
    exec u:r:recovery:s0 -- /system/bin/sleep 1
    start xperia_native_servicemanager
    exec u:r:recovery:s0 -- /system/bin/sleep 1
    start xperia_qseecomd
    start xperia_qsee_hal
    start xperia_keymint
    start xperia_gatekeeper
    mkdir /tmp/xperia-keystore-bin 0755 root root
    copy /system/bin/keystore2 /tmp/xperia-keystore-bin/xperia_keystore2
    chmod 0755 /tmp/xperia-keystore-bin/xperia_keystore2
    mkdir /tmp/xperia-keystore 0700 keystore keystore
    exec u:r:recovery:s0 -- /system/bin/sleep 2
    setprop hwservicemanager.always_sets_disabled true
    setprop hwservicemanager.disabled true
    write /tmp/xperia-keystore-crash.log "Sony Keystore2 trace"
    chown keystore keystore /tmp/xperia-keystore-crash.log
    chmod 0644 /tmp/xperia-keystore-crash.log
    copy /system/bin/xperia_recovery_service_trace /tmp/xperia-keystore-bin/xperia_keystore_trace
    chmod 0755 /tmp/xperia-keystore-bin/xperia_keystore_trace
    start xperia_keystore2
    exec u:r:recovery:s0 -- /system/bin/sleep 2
    exec u:r:recovery:s0 -- /system/bin/timeout 5 /system/bin/sh -c "{ /system/xperia-keystore/bin/service check vendor.qti.hardware.qseecom.IQSEECom/default; /system/xperia-keystore/bin/service check android.hardware.security.keymint.IKeyMintDevice/default; /system/xperia-keystore/bin/service check android.hardware.gatekeeper.IGatekeeper/default; /system/xperia-keystore/bin/service check android.system.keystore2.IKeystoreService/default; /system/xperia-keystore/bin/service check android.security.authorization; } > /tmp/xperia-init-stage 2>&1"
    exec u:r:recovery:s0 -- /system/bin/timeout 5 /system/bin/sh -c "{ echo Sony vendor SKU; /system/bin/getprop ro.boot.product.vendor.sku; /system/bin/cat /proc/mounts | /system/bin/grep -E ' (/odm|/system/etc/vintf) '; /system/bin/dmesg | /system/bin/grep -Ei 'servicemanager|vintf' | /system/bin/tail -60; } >> /tmp/xperia-init-stage 2>&1"
    exec_background u:r:recovery:s0 -- /system/bin/timeout 48 /system/bin/sh -c "{ while ! /system/xperia-keystore/bin/service check android.system.keystore2.IKeystoreService/default | /system/bin/grep -Fqx 'Service android.system.keystore2.IKeystoreService/default: found' || ! /system/xperia-keystore/bin/service check android.security.authorization | /system/bin/grep -Fqx 'Service android.security.authorization: found'; do /system/bin/sleep 1; done; echo 'Sony FBE services ready'; /system/bin/setprop sys.xperia.fbe_client 1; } >> /tmp/xperia-init-stage 2>&1"
    loglevel 6

service xperia_qseecomd /tmp/xperia_recovery_service_trace /vendor/bin/qseecomd
    seclabel u:r:init:s0
    disabled
    oneshot
    user root
    group root drmrpc
    socket notify-topology stream 660 system drmrpc u:r:tee:s0

service xperia_qsee_hal /tmp/xperia_recovery_service_trace /vendor/bin/hw/vendor.qti.hardware.qseecom@1.0-service
    seclabel u:r:init:s0
    disabled
    oneshot
    user system
    group system drmrpc

service xperia_keymint /tmp/xperia_recovery_service_trace /vendor/bin/hw/android.hardware.security.keymint-service-qti
    seclabel u:r:init:s0
    disabled
    oneshot
    user system
    group system drmrpc

service xperia_gatekeeper /tmp/xperia_recovery_service_trace /vendor/bin/hw/android.hardware.gatekeeper-service-qti
    seclabel u:r:init:s0
    disabled
    oneshot
    user system
    group system

service xperia_log_sink /tmp/xperia_recovery_service_trace --collect
    disabled
    oneshot
    user logd
    group logd system
    seclabel u:r:logd:s0
    socket logdw dgram+passcred 0222 logd logd

service xperia_keystore2 /tmp/xperia-keystore-bin/xperia_keystore_trace --trace-keystore
    disabled
    oneshot
    user keystore
    group keystore readproc log
    seclabel u:r:keystore:s0

service xperia_native_servicemanager /system/xperia-keystore/bin/servicemanager
    disabled
    oneshot
    group system readproc
    user root
    seclabel u:r:servicemanager:s0

on property:init.svc.xperia_native_servicemanager=stopped && property:sys.xperia.fbe_probe=1
    umount /system/etc/vintf
    umount /odm
    start servicemanager

# The recovery wrapper owns the single handoff to the UI.

on property:sys.xperia.fbe_client=1 && property:sys.xperia.fbe_probe=1 && property:init.svc.xperia_native_servicemanager=running
    # Temporary locked-state diagnostic ADB; ro.adb.secure remains enabled.
    setprop sys.usb.config adb
    copy /xperia_twrp_native_ld.config.txt /linkerconfig/ld.config.txt


# Extend Sony's existing g1 gadget; retain its VID/PID and ADB setup.
# TWRP's native MtpDescriptors.cpp publishes sys.usb.ffs.mtp.ready.
on fs && property:sys.usb.configfs=1
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /dev/usb-ffs/mtp 0770 root root
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=0,gid=0

on property:sys.usb.config=none && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f2

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    start adbd

on property:sys.usb.config=mtp,adb && property:sys.usb.ffs.ready=1 && property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct 0x4EE2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# Guarded retry requested only after stock firmware is mounted and ADSP is offline.
on property:sys.xperia.adsp_index=0
    write /sys/class/remoteproc/remoteproc0/state start

on property:sys.xperia.adsp_index=1
    write /sys/class/remoteproc/remoteproc1/state start

on property:sys.xperia.adsp_index=2
    write /sys/class/remoteproc/remoteproc2/state start

on property:sys.xperia.adsp_index=3
    write /sys/class/remoteproc/remoteproc3/state start

on property:sys.xperia.adsp_index=4
    write /sys/class/remoteproc/remoteproc4/state start


# Health registers against the final service manager, after firmware setup.
on property:sys.xperia.health_start=1
    start vendor.health-recovery
