# Native logical partition registration. Encrypted Data is integrated separately.
# Source                                   Mount point    Type  Mount flags  FS manager flags
/dev/block/by-name/boot                     /boot          emmc  defaults     slotselect
/dev/block/by-name/init_boot                /init_boot     emmc  defaults     slotselect
/dev/block/by-name/vendor_boot              /vendor_boot   emmc  defaults     slotselect,backup=1,display="Vendor Boot"
/dev/block/by-name/recovery                 /recovery      emmc  defaults     slotselect,backup=1
/dev/block/by-name/dtbo                     /dtbo          emmc  defaults     slotselect,backup=1,display="DTBO"
system /system_root ext4 ro,nodev,noload wait,slotselect,logical
system_ext /system_ext ext4 ro,nodev,noload wait,slotselect,logical
product /product ext4 ro,nodev,noload wait,slotselect,logical
vendor /vendor ext4 ro,nodev,noload wait,slotselect,logical
odm /odm ext4 ro,nodev,noload wait,slotselect,logical
vendor_dlkm /vendor_dlkm ext4 ro,nodev,noload wait,slotselect,logical
system_dlkm /system_dlkm ext4 ro,nodev,noload wait,slotselect,logical
# Native removable storage available before Data decryption.
/dev/block/mmcblk1p1 /external_sd auto nosuid,nodev,noexec storage,removable,canbewiped=0,wipeingui=0,backup=0,display=microSD
